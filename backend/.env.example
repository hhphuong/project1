# Server configuration
SERVER_PORT=8080

# MySQL Database configuration (Local MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=attendance_db
DB_USERNAME=root
DB_PASSWORD=your_local_mysql_password

# CORS configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT configuration
JWT_SECRET=attendance-system-local-jwt-secret-key-at-least-32-chars-2026
JWT_EXPIRATION_MS=86400000